<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Puts the Title column right after the name column of the Assign tab. -->
  <Operation Class="PatchOperationInsert">
    <xpath>/Defs/PawnTableDef[defName="Assign"]/columns/li[text()="LabelShortWithIcon"]</xpath>
    <order>Append</order>
    <value>
      <li>IC_Title</li>
    </value>
  </Operation>
</Patch>
